function [I_total,x_shift,y_shift] = stitch(I_total,r_zone,kx,ky,dx,x_center,y_center,x,y,d_stitch,FOM)
    % During the optimization, the zone image may be shifted a little bit.
    % We will try shifting the zone image around and choose the shift that
    % lead to the highest FOM
    
    Nx = length(x);
    [X,Y] = meshgrid(x,y);
    
    % The shift in x and y that we will test
    shift = 20*dx; % Shift step;
    x_shift = shift;%single(-shift:shift:shift); 
    y_shift = x_shift;
    [X_shift,Y_shift] = meshgrid(x_shift,y_shift);
    X_shift = X_shift(:); Y_shift = Y_shift(:);
    N_shift = length(X_shift); % Number of shifting cases
    
    list_M = []; % List of FOMs of the shifting cases
    list_I = cell(1,1); % List of images of the shifting cases
    for shift_id = 1:N_shift
        % The shift in this case
        x_shift = X_shift(shift_id); y_shift = Y_shift(shift_id);
        % The center of the shifted zone
        x_center_shift = x_center+x_shift; y_center_shift = y_center+y_shift;
        
        % Implement the shift in the matrix
        r_shift = r_zone.*exp(1i*(-kx.')*x_shift+1i*(-ky.')*y_shift);
        r_shift = exp(1i*kx*x_shift+1i*ky*y_shift).*r_shift;
        
        % Build the image
        psi_zone = single(zeros(Nx,Nx));
        for ii = 1:Nx^2
            k_in_x = kx(ii); k_in_y = ky(ii);
            % Convert outputs to spatial basis
            r_shift_ii = reshape(r_shift(:,ii),Nx,Nx);
            r_r_k_ii = ifft(ifftshift(ifft(ifftshift(r_shift_ii,1),Nx,1),2),Nx,2);
            % Convert the inputs to spatial basis
            psi_zone = reshape(r_r_k_ii,Nx,Nx).*exp(-1i*k_in_x*X-1i*k_in_y*Y);

            psi_zone = psi_zone+psi_zone;
        end
        I_zone = abs(psi_zone).^2;
        % Implement the stitching mask
        [stitch_mask] = build_stitching_mask(d_stitch, x_center_shift, y_center_shift, x, y);
        I_zone = I_zone.*stitch_mask;
        
        figure(12
        
        % The total FOV image in this case
        I_total_ii = I_total+I_zone;
        
        M = fom(I_total_ii,FOM);
        
        list_M = [list_M,M];
        list_I{shift_id,1} = I_total_ii;
    end
    
    % The best image
    I_total = list_I{list_M == max(list_M,[],'all'),1};
    % The shift 
    x_shift = X_shift(list_M == max(list_M,[],'all'));
    y_shift = Y_shift(list_M == max(list_M,[],'all'));
end